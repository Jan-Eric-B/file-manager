<ui:FluentWindow
    x:Class="FileManager.Views.Container"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:FileManager.Views.Pages"
    Title="FileManager"
    Width="1200"
    Height="654"
    d:DesignHeight="650"
    d:DesignWidth="900"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title (Row 0) -->
        <ui:TitleBar
            x:Name="RootTitleBar"
            Title="FileManager"
            Grid.Row="0"
            Padding="16,0"
            ForceShutdown="False"
            ShowHelp="False"
            ShowMaximize="True"
            ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/FileManager.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Main navigation; it hosts the pages itself (Row 1) -->
        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            BreadcrumbBar="{Binding ElementName=RootBreadcrumb}"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            OpenPaneLength="200"
            PaneDisplayMode="Left"
            Transition="FadeInWithSlide"
            TransitionDuration="200">
            <ui:NavigationView.Header>
                <ui:BreadcrumbBar
                    x:Name="RootBreadcrumb"
                    Margin="18"
                    FontSize="24" />
            </ui:NavigationView.Header>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="Page 1"
                    Cursor="Hand"
                    TargetPageType="{x:Type pages:Page1}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItemSeparator />
                <ui:NavigationViewItem
                    Content="Page 2"
                    Cursor="Hand"
                    TargetPageType="{x:Type pages:Page2}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Image24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Content="Page 3"
                    Cursor="Hand"
                    TargetPageType="{x:Type pages:Page3}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Video24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <!-- Items without a TargetPageType act as buttons. -->
                <ui:NavigationViewItem
                    Click="NavigationButtonTheme_OnClick"
                    Content="Theme"
                    Cursor="Hand">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DarkTheme24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Click="OpenSettings_OnClick"
                    Content="Settings"
                    Cursor="Hand">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.ContentOverlay>
                <Grid>
                    <ui:SnackbarPresenter x:Name="RootSnackbar" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <!-- Dialogs cover the whole window. -->
        <ui:ContentDialogHost
            x:Name="RootContentDialog"
            Grid.Row="0"
            Grid.RowSpan="2" />
    </Grid>
</ui:FluentWindow>
