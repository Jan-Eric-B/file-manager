<ui:FluentWindow
    x:Class="FileManager.Views.Windows.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:FileManager.Views.Pages"
    Title="Settings"
    Width="600"
    Height="400"
    d:DesignWidth="600"
    d:DesignHeight="400"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TitleBar (Row 0) -->
        <ui:TitleBar
            x:Name="RootTitleBar"
            Grid.Row="0"
            ForceShutdown="False"
            ShowHelp="False"
            ShowMaximize="False"
            ShowMinimize="False" />

        <!-- Navigation and pages (Row 1) -->
        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            BreadcrumbBar="{Binding ElementName=RootBreadcrumb}"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            OpenPaneLength="160"
            PaneDisplayMode="Left">
            <ui:NavigationView.PaneHeader>
                <Grid Margin="6,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Width="40"
                        Height="40"
                        CornerRadius="20">
                        <Border.Background>
                            <ImageBrush ImageSource="pack://application:,,,/Resources/FileManager_Full.png" />
                        </Border.Background>
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                        <TextBlock FontWeight="Medium" Text="Settings" />
                        <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="v.0.0" />
                    </StackPanel>
                </Grid>
            </ui:NavigationView.PaneHeader>
            <ui:NavigationView.Header>
                <ui:BreadcrumbBar x:Name="RootBreadcrumb" Margin="0,0,0,18" />
            </ui:NavigationView.Header>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="Dashboard"
                    Cursor="Hand"
                    TargetPageTag="dashboard"
                    TargetPageType="{x:Type pages:SettingsPageDashboard}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon Source="pack://application:,,,/Resources/microsoft-shell-desktop.ico" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Content="Controls"
                    Cursor="Hand"
                    TargetPageTag="controls"
                    TargetPageType="{x:Type pages:SettingsPageControls}">
                    <ui:NavigationViewItem.Icon>
                        <ui:ImageIcon Source="pack://application:,,,/Resources/microsoft-shell-settings.ico" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
