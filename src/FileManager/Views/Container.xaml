<ui:FluentWindow
    x:Class="FileManager.Views.Container"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:FileManager.Views.Pages"
    xmlns:services="clr-namespace:FileManager.Services"
    xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    Title="FileManager"
    Width="1200"
    Height="654"
    d:DesignHeight="650"
    d:DesignWidth="900"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <CollectionViewSource x:Name="cvsFiles" x:Key="cvsFiles" Source="{Binding Path=ViewModel.Files}" Filter="cvsFiles_Filter" >
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="FileName" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Layout of the content area (right of the navigation pane):
            Header:         path bar across the full width, then breadcrumb (left) and selection/search row (right)
            Page:           the selected tool page, fixed 520 px wide on the left (see the Width on each page)
            ContentOverlay: the file list, right of the page
        -->
        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            BreadcrumbBar="{Binding ElementName=RootBreadcrumb}"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            Navigated="RootNavigation_Navigated"
            OpenPaneLength="150"
            PaneDisplayMode="Left"
            Transition="FadeInWithSlide"
            TransitionDuration="200">
            <ui:NavigationView.Header>
                <Grid x:Name="HeaderGrid" SizeChanged="HeaderGrid_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Path -->
                    <Grid Grid.Row="0" Margin="10,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Margin="5,0" Command="{Binding ViewModel.DirectoryScopeOut}" >↩</ui:Button>
                        <services:SelectableTextBlock Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding Path=ViewModel.MainPath, StringFormat='Path: {0} '}" ToolTip="{Binding Path=ViewModel.MainPath}"/>
                        <!-- Drop target over the path: drop a folder here, click to copy, double-click to open -->
                        <Border Grid.Column="1" Height="33" CornerRadius="4" Background="{DynamicResource ControlFillColorDefaultBrush}" AllowDrop="True" Drop="ProgressBar_Drop" DragOver="ProgressBar_DragOver" MouseDown="Path_MouseDown"/>
                        <ui:Button Grid.Column="2" Margin="5,0,0,0" Command="{Binding ViewModel.OpenFolderDialog}" >...</ui:Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="520" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ui:BreadcrumbBar
                            x:Name="RootBreadcrumb"
                            Grid.Column="0"
                            Margin="10,5,0,5"
                            VerticalAlignment="Center"
                            FontSize="24" />

                        <!-- Selection, search, extension and filter -->
                        <Grid Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="7*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <VirtualizingStackPanel Orientation="Horizontal" Grid.Column="0">
                                <CheckBox x:Name="cboSelectEverySecondFirst" MinWidth="0" Padding="0" ToolTip="selects every second item. All odd items" IsChecked="{Binding Path=ViewModel.SelectEverySecondFirst, Mode=TwoWay}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="cboSelect_Click" />
                                <CheckBox x:Name="cboSelectEverySecondLast" MinWidth="0" Padding="0" ToolTip="selects every second item. All even items" IsChecked="{Binding Path=ViewModel.SelectEverySecondLast, Mode=TwoWay}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="cboSelect_Click" />
                                <CheckBox x:Name="cboSelectAll" ToolTip="Select all visible" IsChecked="{Binding Path=ViewModel.SelectAll, Mode=TwoWay}" Margin="12,0,12,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="Select All" Cursor="Hand" Click="cboSelect_Click" />
                            </VirtualizingStackPanel>

                            <ui:TextBox x:Name="txSearch" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Path=ViewModel.SearchInput}" Cursor="IBeam" Padding="5" TextChanged="TextBox_TextChanged"/>

                            <ComboBox x:Name="cmbFileExtensions" Grid.Column="2" Background="Transparent" Height="40" Margin="5,0,0,0" SelectedIndex="{Binding Path=ViewModel.SelectedFileExtension}" ItemsSource="{Binding Path=ViewModel.FileExtensions}" SelectionChanged="cmbFileExtensions_SelectionChanged"/>

                            <Menu Grid.Column="3" Background="Transparent" HorizontalAlignment="Right" Height="45">
                                <ui:MenuItem Header="Filter" Icon="{ui:SymbolIcon Filter24}">
                                    <StackPanel>
                                        <CheckBox Content="Subdirectories" IsChecked="{Binding Path=ViewModel.SearchOptionsSubdirectories, Mode=TwoWay}" Click="CheckBox_Click" />
                                        <CheckBox Content="Case sensitive" IsChecked="{Binding Path=ViewModel.SearchOptionsCaseSensitive, Mode=TwoWay}" />
                                        <CheckBox Content="File Name" IsChecked="{Binding Path=ViewModel.SearchOptionsFileName, Mode=TwoWay}" />
                                        <CheckBox Content="File Content" IsChecked="{Binding Path=ViewModel.SearchOptionsFileContent, Mode=TwoWay}" />
                                    </StackPanel>
                                </ui:MenuItem>
                            </Menu>
                        </Grid>
                    </Grid>
                </Grid>
            </ui:NavigationView.Header>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="General"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Home24}"
                    TargetPageType="{x:Type pages:GeneralPage}" />
                <ui:NavigationViewItemSeparator />
                <ui:NavigationViewItem
                    Content="Images"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Image24}"
                    TargetPageType="{x:Type pages:ImagePage}" />
                <ui:NavigationViewItem
                    Content="Videos"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Video24}"
                    TargetPageType="{x:Type pages:VideoPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <!-- Items without a TargetPageType act as buttons. -->
                <ui:NavigationViewItem
                    Click="NavigationButtonTheme_OnClick"
                    Content="Theme"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon DarkTheme24}" />
                <ui:NavigationViewItem
                    Click="OpenSettings_OnClick"
                    Content="Settings"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Settings24}" />
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.ContentOverlay>
                <Grid x:Name="OverlayRoot" Loaded="OverlayRoot_Loaded">
                    <!-- File list, right of the 520 px page and below the header (top margin set in HeaderGrid_SizeChanged) -->
                    <Grid x:Name="FileListPanel" Margin="520,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl Name="ItemsControl" Margin="15" ItemsSource="{Binding Source={StaticResource cvsFiles}}" Background="#00000000" BorderBrush="#00000000">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <VirtualizingStackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <CheckBox Checked="CheckBox_Checked" IsChecked="{Binding IsChecked, Mode=TwoWay}" Unchecked="CheckBox_Unchecked" Margin="3" MouseEnter="Checkbox_OnMouseEnter" GotMouseCapture="Checkbox_OnGotMouseCapture"/>
                                                    <VirtualizingStackPanel Orientation="Horizontal" Margin="8,0,0,0" >
                                                        <TextBlock Text="{Binding SubdirectoryPath}" FontStyle="Italic"  FontSize="12" Margin="0,2,0,0" VerticalAlignment="Center" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown" />
                                                        <services:SelectableTextBlock services:HighlightTermBehavior.Text="{Binding FileName}" services:HighlightTermBehavior.TermToBeHighlighted="{Binding HighlightedText}" VerticalAlignment="Center" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown" />
                                                    </VirtualizingStackPanel>
                                                </VirtualizingStackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" >
                                                    <Border CornerRadius="10" Background="{DynamicResource ApplicationBackgroundBrush}">
                                                        <TextBlock Text="{Binding FileSize}" Padding="5"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <StackPanel Orientation="Horizontal" Grid.Row="1">
                            <TextBlock Text="{Binding ViewModel.FileCount, StringFormat=' {0} Elements | '}" />
                            <TextBlock Text="{Binding ViewModel.FileCountSelected, StringFormat=' {0} Selected Elements'}" />
                        </StackPanel>
                    </Grid>

                    <!-- Pop-ups shown through ISnackbarService -->
                    <ui:SnackbarPresenter x:Name="RootSnackbar" MaxWidth="600" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <!-- Title (Row 0)-->
        <ui:TitleBar
            Title="FileManager"
            Grid.Row="0"
            Padding="16,0"
            ForceShutdown="False"
            ShowHelp="False"
            ShowMaximize="True"
            ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/Icons/FileManager.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

    </Grid>
</ui:FluentWindow>
