<ui:FluentWindow
    x:Class="FileManager.Views.Container"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:FileManager.Views.Pages"
    xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    xmlns:services="clr-namespace:FileManager.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="FileManager"
    Width="1200"
    Height="654"
    d:DesignHeight="650"
    d:DesignWidth="900"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <CollectionViewSource
            x:Key="cvsFiles"
            x:Name="cvsFiles"
            Filter="cvsFiles_Filter"
            Source="{Binding Path=ViewModel.Files}">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="FileName" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Layout of the content area (right of the navigation pane):
            Header:         path bar across the full width, then breadcrumb (left) and selection/search row (right)
            Page:           the selected tool page, fixed 520 px wide on the left (see the Width on each page)
            ContentOverlay: the file list, right of the page
        -->
        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            BreadcrumbBar="{Binding ElementName=RootBreadcrumb}"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsFooterSeparatorVisible="False"
            IsPaneOpen="False"
            Navigated="RootNavigation_Navigated"
            OpenPaneLength="150"
            PaneDisplayMode="Left"
            Transition="FadeInWithSlide"
            TransitionDuration="200">
            <ui:NavigationView.Header>
                <Grid x:Name="HeaderGrid" SizeChanged="HeaderGrid_SizeChanged">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Path  -->
                    <Grid Grid.Row="0" Margin="10,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <ui:Button
                            Grid.Column="0"
                            Margin="5,0"
                            Command="{Binding ViewModel.DirectoryScopeOut}">
                            ↩
                        </ui:Button>
                        <services:SelectableTextBlock
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding Path=ViewModel.MainPath, StringFormat='Path: {0} '}"
                            ToolTip="{Binding Path=ViewModel.MainPath}" />
                        <!--  Drop target over the path: drop a folder here, click to copy, double-click to open  -->
                        <Border
                            Grid.Column="1"
                            Height="33"
                            AllowDrop="True"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="4"
                            DragOver="ProgressBar_DragOver"
                            Drop="ProgressBar_Drop"
                            MouseDown="Path_MouseDown" />
                        <ui:Button
                            Grid.Column="2"
                            Margin="5,0,0,0"
                            Command="{Binding ViewModel.OpenFolderDialog}">
                            ...
                        </ui:Button>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="520" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ui:BreadcrumbBar
                            x:Name="RootBreadcrumb"
                            Grid.Column="0"
                            Margin="18,5,0,5"
                            VerticalAlignment="Center"
                            FontSize="24" />

                        <!--  Selection, search, extension and filter  -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="7*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <VirtualizingStackPanel Grid.Column="0" Orientation="Horizontal">
                                <CheckBox
                                    x:Name="cboSelectEverySecondFirst"
                                    MinWidth="0"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Click="cboSelect_Click"
                                    IsChecked="{Binding Path=ViewModel.SelectEverySecondFirst, Mode=TwoWay}"
                                    ToolTip="selects every second item. All odd items" />
                                <CheckBox
                                    x:Name="cboSelectEverySecondLast"
                                    MinWidth="0"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Click="cboSelect_Click"
                                    IsChecked="{Binding Path=ViewModel.SelectEverySecondLast, Mode=TwoWay}"
                                    ToolTip="selects every second item. All even items" />
                                <CheckBox
                                    x:Name="cboSelectAll"
                                    MinWidth="0"
                                    Margin="10,0,12,0"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Click="cboSelect_Click"
                                    Content="Select All"
                                    Cursor="Hand"
                                    IsChecked="{Binding Path=ViewModel.SelectAll, Mode=TwoWay}"
                                    ToolTip="Select all visible" />
                            </VirtualizingStackPanel>

                            <ui:TextBox
                                x:Name="txSearch"
                                Grid.Column="1"
                                Padding="5"
                                VerticalAlignment="Center"
                                Cursor="IBeam"
                                Text="{Binding Path=ViewModel.SearchInput}"
                                TextChanged="TextBox_TextChanged" />

                            <ComboBox
                                x:Name="cmbFileExtensions"
                                Grid.Column="2"
                                Height="{Binding ActualHeight, ElementName=txSearch}"
                                Margin="5,0,0,0"
                                Padding="10,5"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                ItemsSource="{Binding Path=ViewModel.FileExtensions}"
                                SelectedIndex="{Binding Path=ViewModel.SelectedFileExtension}"
                                SelectionChanged="cmbFileExtensions_SelectionChanged" />

                            <Menu
                                Grid.Column="3"
                                Height="45"
                                HorizontalAlignment="Right"
                                Background="Transparent">
                                <ui:MenuItem Header="Filter" Icon="{ui:SymbolIcon Filter24}">
                                    <StackPanel>
                                        <CheckBox
                                            Click="CheckBox_Click"
                                            Content="Subdirectories"
                                            IsChecked="{Binding Path=ViewModel.SearchOptionsSubdirectories, Mode=TwoWay}" />
                                        <CheckBox Content="Case sensitive" IsChecked="{Binding Path=ViewModel.SearchOptionsCaseSensitive, Mode=TwoWay}" />
                                        <CheckBox Content="File Name" IsChecked="{Binding Path=ViewModel.SearchOptionsFileName, Mode=TwoWay}" />
                                        <CheckBox Content="File Content" IsChecked="{Binding Path=ViewModel.SearchOptionsFileContent, Mode=TwoWay}" />
                                    </StackPanel>
                                </ui:MenuItem>
                            </Menu>
                        </Grid>
                    </Grid>
                </Grid>
            </ui:NavigationView.Header>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="General"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Home24}"
                    TargetPageType="{x:Type pages:GeneralPage}" />
                <ui:NavigationViewItemSeparator />
                <ui:NavigationViewItem
                    Content="Images"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Image24}"
                    TargetPageType="{x:Type pages:ImagePage}" />
                <ui:NavigationViewItem
                    Content="Videos"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Video24}"
                    TargetPageType="{x:Type pages:VideoPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <!--  Items without a TargetPageType act as buttons.  -->
                <ui:NavigationViewItem
                    Click="NavigationButtonTheme_OnClick"
                    Content="Theme"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon DarkTheme24}" />
                <ui:NavigationViewItem
                    Click="OpenSettings_OnClick"
                    Content="Settings"
                    Cursor="Hand"
                    Icon="{ui:SymbolIcon Settings24}" />
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.ContentOverlay>
                <Grid x:Name="OverlayRoot" Loaded="OverlayRoot_Loaded">
                    <!--  File list, right of the 520 px page and below the header (top margin set in HeaderGrid_SizeChanged)  -->
                    <Grid x:Name="FileListPanel" Margin="520,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            CornerRadius="8,0,0,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl
                                    Name="ItemsControl"
                                    Margin="15"
                                    Background="#00000000"
                                    BorderBrush="#00000000"
                                    ItemsSource="{Binding Source={StaticResource cvsFiles}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <VirtualizingStackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                                                    <CheckBox
                                                        MinWidth="0"
                                                        Margin="3"
                                                        Padding="0"
                                                        Checked="CheckBox_Checked"
                                                        GotMouseCapture="Checkbox_OnGotMouseCapture"
                                                        IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                        MouseEnter="Checkbox_OnMouseEnter"
                                                        Unchecked="CheckBox_Unchecked" />
                                                    <VirtualizingStackPanel Margin="10,0,0,0" Orientation="Horizontal">
                                                        <TextBlock
                                                            Margin="0,2,0,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            FontStyle="Italic"
                                                            MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                                                            Text="{Binding SubdirectoryPath}" />
                                                        <services:SelectableTextBlock
                                                            VerticalAlignment="Center"
                                                            services:HighlightTermBehavior.TermToBeHighlighted="{Binding HighlightedText}"
                                                            services:HighlightTermBehavior.Text="{Binding FileName}"
                                                            MouseLeftButtonDown="TextBlock_MouseLeftButtonDown" />
                                                    </VirtualizingStackPanel>
                                                </VirtualizingStackPanel>
                                                <StackPanel
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <Border Background="{DynamicResource ApplicationBackgroundBrush}" CornerRadius="10">
                                                        <TextBlock Padding="5" Text="{Binding FileSize}" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding ViewModel.FileCount, StringFormat=' {0} Elements | '}" />
                            <TextBlock Text="{Binding ViewModel.FileCountSelected, StringFormat=' {0} Selected Elements'}" />
                        </StackPanel>
                    </Grid>

                    <!--  Pop-ups shown through ISnackbarService  -->
                    <ui:SnackbarPresenter x:Name="RootSnackbar" MaxWidth="600" />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>

        <!--  Title (Row 0)  -->
        <ui:TitleBar
            Grid.Row="0"
            Height="30"
            ForceShutdown="False"
            ShowHelp="False"
            ShowMaximize="True"
            ShowMinimize="True">
            <ui:TitleBar.Header>
                <StackPanel
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Image
                        Height="19"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="pack://application:,,,/Resources/Icons/FileManager.png" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="FileManager" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

    </Grid>
</ui:FluentWindow>
